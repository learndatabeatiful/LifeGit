{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifegit.local/schemas/event.schema.json",
  "title": "LifeGit Event",
  "type": "object",
  "required": ["id", "date", "event", "related_people", "related_memories", "decision_point", "long_term_impact"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^evt_[a-z0-9_]+$" },
    "date": { "type": "string" },
    "event": { "type": "string" },
    "causes": { "type": "array", "items": { "type": "string" } },
    "consequences": { "type": "array", "items": { "type": "string" } },
    "related_people": { "type": "array", "items": { "type": "string" } },
    "related_memories": { "type": "array", "items": { "type": "string" } },
    "decision_point": { "type": "boolean" },
    "alternative_choices": { "type": "array", "items": { "type": "string" } },
    "emotional_result": { "type": "string" },
    "long_term_impact": { "type": "string" },
    "simulation_allowed": { "type": "boolean" },
    "sensitivity": { "enum": ["low", "medium", "high"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
