{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifegit.local/schemas/passion.schema.json",
  "title": "LifeGit Passion Line",
  "type": "object",
  "required": ["id", "name", "origin", "stages", "changed_what"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^passion_[a-z0-9_]+$"},
    "name": {"type": "string"},
    "origin": {"type": "string"},
    "stages": {"type": "array", "items": {"type": "string"}},
    "changed_what": {"type": "string"},
    "cost_or_shadow": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
