{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifegit.local/schemas/place.schema.json",
  "title": "LifeGit Place Card",
  "type": "object",
  "required": ["id", "name_or_token", "time_range", "events", "why_it_matters"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^place_[a-z0-9_]+$"},
    "name_or_token": {"type": "string"},
    "time_range": {"type": "string"},
    "events": {"type": "array", "items": {"type": "string"}},
    "why_it_matters": {"type": "string"},
    "return_feeling": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
