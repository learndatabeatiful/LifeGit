{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifegit.local/schemas/character.schema.json",
  "title": "LifeGit Character",
  "type": "object",
  "required": ["id", "display_name", "relation_to_user", "privacy_level", "traits", "behavior_constraints"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^char_[a-z0-9_]+$" },
    "display_name": { "type": "string" },
    "real_name_token": { "type": ["string", "null"] },
    "relation_to_user": { "type": "string" },
    "privacy_level": { "enum": ["public", "light", "medium", "heavy"] },
    "traits": { "type": "array", "items": { "type": "string" } },
    "values": { "type": "array", "items": { "type": "string" } },
    "fears": { "type": "array", "items": { "type": "string" } },
    "motivations": { "type": "array", "items": { "type": "string" } },
    "communication_style": { "type": "string" },
    "relationship_history": { "type": "array", "items": { "type": "string" } },
    "key_memories": { "type": "array", "items": { "type": "string" } },
    "behavior_constraints": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
