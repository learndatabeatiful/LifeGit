{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifegit.local/schemas/creation.schema.json",
  "title": "LifeGit Creation Artifact",
  "type": "object",
  "required": ["id", "title", "type", "time_range", "why_it_matters"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^creation_[a-z0-9_]+$"},
    "title": {"type": "string"},
    "type": {"enum": ["writing", "photo", "code", "project", "business", "video", "music", "other"]},
    "time_range": {"type": "string"},
    "evidence_ref": {"type": ["string", "null"]},
    "why_it_matters": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
