{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifegit.local/schemas/memory.schema.json",
  "title": "LifeGit Memory",
  "type": "object",
  "required": ["id", "date", "place", "people", "event_summary", "emotions", "importance_score", "confidence"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^mem_[a-z0-9_]+$" },
    "date": { "type": "string" },
    "place": { "type": "string" },
    "people": { "type": "array", "items": { "type": "string" } },
    "event_summary": { "type": "string" },
    "raw_materials": { "type": "array", "items": { "type": "string" } },
    "emotions": { "type": "array", "items": { "type": "string" } },
    "sensory_details": { "type": "array", "items": { "type": "string" } },
    "importance_score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "unresolved_feelings": { "type": "array", "items": { "type": "string" } },
    "related_music": { "type": "array", "items": { "type": "string" } },
    "related_photos": { "type": "array", "items": { "type": "string" } },
    "related_text": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
