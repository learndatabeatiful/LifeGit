{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifegit.local/schemas/belief-snapshot.schema.json",
  "title": "LifeGit Belief Snapshot",
  "type": "object",
  "required": ["id", "time_range", "belief", "later_change", "evidence"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^belief_[a-z0-9_]+$"},
    "time_range": {"type": "string"},
    "belief": {"type": "string"},
    "later_change": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
